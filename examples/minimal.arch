architecture "Hello, architecture" {
  model {
    person user "User"
    application app "Your application" {
      description "A small idea, clearly connected."
      technology "Browser · No dependencies"
    }
    database data "Your data"
    relation uses user -> app "Uses"
    relation reads app -> data "Reads / writes" { type access }
  }
  view default "Complete overview" {}
  view public "Public view · exclude wins" {
    include user, app, data
    exclude data
    style app { backgroundColor AliceBlue accent SlateBlue opacity 0.55 }
  }
}
