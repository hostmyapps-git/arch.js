{
  "name": "archjs",
  "version": "0.1.0",
  "private": true,
  "description": "A readable architecture language and dependency-free inline SVG renderer",
  "type": "module",
  "main": "./src/arch.js",
  "exports": "./src/arch.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "icons:download": "node scripts/download-icons.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run build && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.28.2",
    "playwright": "1.65.1",
    "svgpath": "2.6.0"
  }
}
